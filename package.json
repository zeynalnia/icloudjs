{
  "name": "jsicloud",
  "version": "2.0.0",
  "description": "Unofficial NestJS client for Apple iCloud web services (port of pyicloud).",
  "license": "MIT",
  "bin": {
    "jsicloud": "dist/cli/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeynalnia/icloudjs.git"
  },
  "homepage": "https://github.com/zeynalnia/icloudjs#readme",
  "bugs": {
    "url": "https://github.com/zeynalnia/icloudjs/issues"
  },
  "keywords": [
    "icloud",
    "pyicloud",
    "nestjs",
    "find-my-iphone",
    "icloud-drive",
    "icloud-photos",
    "apple"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:cli": "ts-node src/cli/main.ts",
    "test": "jest --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@foxt/js-srp": "^0.0.3-patch2",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "axios": "^1.7.0",
    "axios-cookiejar-support": "^7.0.0",
    "commander": "^15.0.0",
    "http-cookie-agent": "^8.0.0",
    "keytar": "^7.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tough-cookie": "^4.1.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/tough-cookie": "^4.0.5",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "nock": "^13.5.4",
    "prettier": "^3.3.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
